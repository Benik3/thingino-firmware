--- a/common/cmd_sdupdate.c
+++ b/common/cmd_sdupdate.c
@@ -4,14 +4,30 @@
 #include <common.h>
 #include <command.h>
 #include <environment.h>
+#include <image.h>
+#include <malloc.h>
+#include <sha256.h>
+#include <spi_flash.h>
 
